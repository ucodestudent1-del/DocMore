# Backend
SECRET_KEY=change-me-in-production
REDIS_URL=redis://redis:6379/0
MAX_FILE_SIZE=52428800
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PORT=8000

# Database (PostgreSQL 15)
DATABASE_URL=postgresql://postgres:hzxLMRTmXnAEdSPjYlUaSHgmFJxxPtVF@postgres.railway.internal:5432/railway
STORAGE_BACKEND=local

# AWS S3 / Object Storage (required when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=everydoc-uploads
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=  # e.g. http://minio:9000 for MinIO

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@everydoc.app

# AI provider keys (server-side only; never exposed to frontend)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AI_PROVIDER=openai  # openai | anthropic | google

# Malware scanning (ClamAV)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Data retention
RETENTION_HOURS=24

# Processing limits
MAX_BATCH_FILES=20
PROCESSING_TIMEOUT=300

# Frontend
NEXT_PUBLIC_API_BASE=/api
