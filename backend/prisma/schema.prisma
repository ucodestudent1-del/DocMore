// DocStudio — Prisma Schema (Phase 1 Foundation)
// Canonical database schema for PostgreSQL 15

generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum DocumentKind {
  UPLOAD
  OUTPUT
  TEMPLATE
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_RESET
  EMAIL_VERIFY
  TIER_CHANGE
  FILE_DELETE
  GDPR_DELETE
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  username          String              @unique @db.VarChar(255)
  email             String              @unique @db.VarChar(255)
  hashedPassword    String              @db.VarChar(255)
  tier              SubscriptionTier    @default(FREE)
  role              UserRole            @default(USER)
  isVerified        Boolean             @default(false)
  emailVerifiedAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  sessions          Session[]
  documents         Document[]
  jobs              Job[]
  subscriptions     Subscription[]
  usageRecords      UsageRecord[]
  auditLogs         AuditLog[]
  folders           Folder[]
  sharedDocuments   DocumentShare[]
  outputs           Output[] @relation("OutputUser")

  @@index([email])
  @@index([username])
  @@index([tier])
  @@index([role])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique @db.VarChar(512)
  userAgent    String?  @db.VarChar(512)
  ipAddress    String?  @db.VarChar(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model Folder {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  parentId    String?  @db.Uuid
  name        String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[] @relation("FolderHierarchy")
  documents   Document[]

  @@index([userId])
  @@index([parentId])
}

model Document {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  folderId      String?       @db.Uuid
  kind          DocumentKind  @default(UPLOAD)
  originalName  String        @db.VarChar(255)
  storedName    String        @db.VarChar(255)
  mime          String        @db.VarChar(100)
  ext           String        @db.VarChar(20)
  size          Int
  storagePath   String        @db.VarChar(500)
  storageBackend String       @default("local") @db.VarChar(20)
  checksum      String?       @db.VarChar(64)
  isInfected    Boolean       @default(false)
  versionHead   Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  expiresAt     DateTime?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder        Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions      DocumentVersion[] @relation("DocumentVersionDocument")
  documentVersionFile DocumentVersion[] @relation("DocumentVersionFile")
  outputs       Output[]
  shares        DocumentShare[]

  @@index([userId])
  @@index([folderId])
  @@index([kind])
  @@index([expiresAt])
}

model DocumentVersion {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @db.Uuid
  version     Int
  fileId      String   @db.Uuid
  createdAt   DateTime @default(now())

  document    Document @relation("DocumentVersionDocument", fields: [documentId], references: [id], onDelete: Cascade)
  file        Document @relation("DocumentVersionFile", fields: [fileId], references: [id])

  @@index([documentId])
  @@index([documentId, version])
}

model Output {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String?  @db.Uuid
  userId        String   @db.Uuid
  originalName  String   @db.VarChar(255)
  storedName    String   @db.VarChar(255)
  mime          String   @db.VarChar(100)
  ext           String   @db.VarChar(20)
  size          Int
  storagePath   String   @db.VarChar(500)
  storageBackend String  @default("local") @db.VarChar(20)
  createdAt     DateTime @default(now())
  expiresAt     DateTime?

  user          User     @relation("OutputUser", fields: [userId], references: [id], onDelete: Cascade)
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  job           Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId         String?

  @@index([userId])
  @@index([documentId])
  @@index([jobId])
}

model Job {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid
  taskName    String     @db.VarChar(100)
  status      JobStatus  @default(PENDING)
  progress    Int        @default(0)
  result      String?    @db.Text
  error       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  outputs     Output[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @db.Uuid
  stripeCustomerId     String?            @unique @db.VarChar(255)
  stripeSubscriptionId String?            @unique @db.VarChar(255)
  stripePriceId        String?            @db.VarChar(255)
  status               SubscriptionStatus @default(INCOMPLETE)
  tier                 SubscriptionTier   @default(FREE)
  interval             String             @default("monthly") @db.VarChar(20)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
}

model UsageRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  month       String   @db.VarChar(7) // "2026-11"
  conversions Int      @default(0)
  storageMB   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, month], map: "usage_user_month_idx")
}

model AuditLog {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @db.Uuid
  action    AuditAction
  target    String?    @db.VarChar(255)
  targetId  String?    @db.Uuid
  metadata  Json?
  ipAddress String?    @db.VarChar(64)
  userAgent String?    @db.VarChar(512)
  createdAt DateTime   @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model DocumentShare {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @db.Uuid
  sharedWithId String  @db.Uuid
  permission  String   @default("view") @db.VarChar(20) // view, edit
  createdAt   DateTime @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedWith  User     @relation(fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([sharedWithId])
  @@unique([documentId, sharedWithId], map: "share_unique")
}
