{
  "name": "everydoc-backend",
  "version": "1.0.0",
  "private": true,
  "description": "EveryDoc MVP backend - document generation and conversion API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "docx": "^8.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mammoth": "^1.8.0",
    "marked": "^12.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.12.0",
    "turndown": "^7.2.0",
    "ulid": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.1",
    "@types/pg": "^8.23.1",
    "eslint": "^8.57.0",
    "tsx": "^4.11.0",
    "typescript": "^5.5.0"
  }
}
